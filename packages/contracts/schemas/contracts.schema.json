{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts.schema.json",
  "title": "BimContracts",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "DrawingUnits": {
      "type": "string",
      "enum": ["mm", "m", "from_file"]
    },
    "DrawingStatus": {
      "type": "string",
      "enum": ["uploaded", "processing", "processed", "error"]
    },
    "DrawingDetailStatus": {
      "type": "string",
      "enum": ["pending", "uploaded", "processing", "processed", "failed"]
    },
    "Drawing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerId",
        "originalFileName",
        "storagePath",
        "units",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "originalFileName": { "type": "string" },
        "storagePath": { "type": "string" },
        "resultStoragePath": { "type": ["string", "null"] },
        "units": { "$ref": "#/$defs/DrawingUnits" },
        "status": { "$ref": "#/$defs/DrawingStatus" },
        "errorMessage": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DrawingDetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerId",
        "originalFileName",
        "storagePath",
        "units",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "originalFileName": { "type": "string" },
        "storagePath": { "type": "string" },
        "units": { "type": "string" },
        "status": { "$ref": "#/$defs/DrawingDetailStatus" },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceDownloadUrl": { "type": ["string", "null"], "format": "uri" },
        "sourceDownloadUrlExpiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "properties": {
    "drawing": { "$ref": "#/$defs/Drawing" },
    "drawingDetailResponse": { "$ref": "#/$defs/DrawingDetailResponse" }
  }
}