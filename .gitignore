# Python & FastAPI Backend (apps/api)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/

# ==============================================================================
# Cloud Platforms & Local Dev CLI State (Vercel, Supabase)
# ==============================================================================
.vercel/
supabase/.temp/

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Certificates, Keys & Credentials
*.key
*.pfx
*.p12
service-account*.json
secrets/

# ==============================================================================
# Temporary Files, Logs & Local Storage
# ==============================================================================
/tmp/
/temp/
/uploads/
*.tmp
*.log
*.sqlite
*.sqlite3
*.db

# ==============================================================================
# Client Drawings, BIM Models & Proprietary Standards
# ==============================================================================
# CAD / Drawings
*.dwg
*.dxf

# AutoCAD Lock, Backup & Autosave files
*.bak
*.dwl
*.dwl2
*.sv$
*.ac$

# BIM Models & Revit files
*.rvt
*.rfa
*.ifc

# Private and licensed standards documentation
docs/standards/private/
docs/standards/paid/

# Openly licensed test fixtures are explicitly allowed
!**/tests/fixtures/**/*.dxf
!**/tests/fixtures/**/*.dwg

# ==============================================================================
