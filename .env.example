# API server origin; clients use /api/v1 endpoints.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service configuration (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=drawings
SUPABASE_ANON_KEY=your-anon-key

# Explicit local result demo; ignored in production.
NEXT_PUBLIC_DRAWING_DEMO=false

# Norms Search Agent Settings (BIM-163)
NORMS_SEARCH_API_KEY=your-gemini-api-key
NORMS_SEARCH_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
NORMS_SEARCH_MODEL=gemini-2.5-flash