    "default": "1px",
    "strong": "2px",
    "focus": "2px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "md": "0 4px 12px rgba(15, 23, 42, 0.08)",
    "lg": "0 12px 32px rgba(15, 23, 42, 0.12)"
  },
  "size": {
    "controlSm": "32px",
    "controlMd": "40px",
    "controlLg": "48px",
