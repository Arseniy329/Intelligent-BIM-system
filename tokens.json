    "iconSm": "16px",
    "iconMd": "20px",
    "iconLg": "24px",
    "planMarker": "8px",
    "planMarkerSelected": "12px"
  },
  "component": {
    "button": {
      "height": {
        "sm": "32px",
        "md": "40px",
        "lg": "48px"
      },
      "paddingX": {
        "sm": "12px",
        "md": "16px",
        "lg": "20px"
      },
      "radius": "8px",
      "fontWeight": 500,
      "focusRingWidth": "2px",
      "loadingOpacity": 0.8
    },
    "input": {
      "height": "40px",
      "paddingX": "12px",
      "radius": "8px",
      "borderWidth": "1px",
      "focusRingWidth": "2px"
    },
    "table": {
      "headerHeight": "40px",
      "rowMinHeight": "44px",
      "cellPaddingX": "12px",
      "cellPaddingY": "12px",
      "radius": "8px"
    },
    "badge": {
      "minHeight": "24px",
      "paddingX": "8px",
      "paddingY": "4px",
      "radius": "999px",
      "fontSize": "12px",
      "fontWeight": 500
    },
    "planPanel": {
      "toolbarHeight": "40px",
      "panelRadius": "12px",
      "panelBorderWidth": "1px",
      "legendItemGap": "8px",
      "layerRowMinHeight": "36px",
      "canvasPadding": "16px"
    }
  },
  "state": {
    "focus": {
      "borderColor": "#2563EB",
      "ringColor": "#BFDBFE",
      "ringWidth": "2px"
    },
    "disabled": {
      "opacity": 0.65,
      "cursor": "not-allowed"
    },
    "loading": {
      "opacity": 0.8,
      "cursor": "progress"
    },
    "selected": {
      "background": "#EFF6FF",
      "borderColor": "#2563EB"
    }
  },
  "motion": {
    "durationFast": "100ms",
    "durationNormal": "180ms",
    "durationSlow": "240ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)"
  }
